{
  "expo": {
    "name": "CAPS S&C",
    "slug": "caps-sc",
    "version": "1.0.0",
    "description": "Combat Athlete Performance System",
    "orientation": "portrait",
    "icon": "./assets/images/CAPS Logo v3.png",
    "scheme": "capssc",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_SLEEP"
      ]
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CAPS uses your location to record distance and route during conditioning.",
          "locationAlwaysAndWhenInUsePermission": "CAPS records your conditioning route, including while the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true,
          "cameraPermission": "Allow CAPS to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-asset",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "CAPS reads resting heart rate, HRV, breathing rate and sleep to show your recovery markers and personal trends on this device.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 26 } }
      ]
    ]
  }
}
