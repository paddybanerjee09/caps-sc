{
  "expo": {
    "name": "CAPS S&C",
    "slug": "caps-sc",
    "version": "1.0.0",
    "description": "Combat Athlete Performance System",
    "orientation": "portrait",
    "icon": "./assets/images/CAPS App Logo.png",
    "scheme": "capssc",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CAPS uses your location to record distance and route during conditioning.",
          "locationAlwaysAndWhenInUsePermission": "CAPS records your conditioning route, including while the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true,
          "cameraPermission": "Allow CAPS to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
